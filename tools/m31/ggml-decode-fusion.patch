diff --git a/ggml/include/ggml-cuda.h b/ggml/include/ggml-cuda.h
--- a/ggml/include/ggml-cuda.h
+++ b/ggml/include/ggml-cuda.h
@@ -50,6 +50,18 @@
 
 GGML_BACKEND_API ggml_backend_reg_t ggml_backend_cuda_reg(void);
 
+// xolotl M31: serialized, per-backend fusion selection. -1 inherits the process
+// environment, 0 disables fusion, 1 enables it. A changed mode drains pending
+// work and drops this backend's cached CUDA graphs before changing their policy.
+// Invalid modes/non-CUDA backends return false without changing state. The
+// caller externally serializes setters with backend compute/submission/free.
+#define GGML_CUDA_HAS_FUSION_OVERRIDE 1
+GGML_BACKEND_API bool ggml_backend_cuda_set_fusion_override(ggml_backend_t backend, int mode);
+// -2 for non-CUDA; otherwise -1/0/1. Does not initialize or synchronize a device.
+GGML_BACKEND_API int ggml_backend_cuda_get_fusion_override(ggml_backend_t backend);
+
+
+
 #ifdef  __cplusplus
 }
 #endif
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -168,9 +168,22 @@
     return enabled;
 }
 
-static bool ggml_cuda_fusion_disabled() {
+// Side state preserves ggml_backend_cuda_context's layout: this opt-in API
+// does not require recompiling every CUDA kernel TU. A graph capture consults
+// the map; steady CUDA graph replay does not run the node fusion matcher.
+static std::mutex ggml_cuda_fusion_override_mutex;
+static std::unordered_map<const ggml_backend_cuda_context *, int> ggml_cuda_fusion_overrides;
+
+static int ggml_cuda_fusion_override(const ggml_backend_cuda_context * ctx) {
+    std::lock_guard<std::mutex> lock(ggml_cuda_fusion_override_mutex);
+    const auto found = ggml_cuda_fusion_overrides.find(ctx);
+    return found == ggml_cuda_fusion_overrides.end() ? -1 : found->second;
+}
+
+static bool ggml_cuda_fusion_disabled(const ggml_backend_cuda_context * ctx) {
     static const bool disabled = ggml_cuda_env_flag("GGML_CUDA_DISABLE_FUSION");
-    return disabled;
+    const int mode = ggml_cuda_fusion_override(ctx);
+    return mode == -1 ? disabled : mode == 0;
 }
 
 static bool ggml_cuda_p2p_enabled() {
