         return 0;
     }
 
@@ -5019,7 +5036,7 @@
 static void ggml_backend_cuda_graph_optimize(ggml_backend_t backend, ggml_cgraph * cgraph, ggml_backend_graph_optimize_params * params) {
     ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
 
-    const bool disable_fusion = ggml_cuda_fusion_disabled();
+    const bool disable_fusion = ggml_cuda_fusion_disabled(cuda_ctx);
 
     auto add_alloc_deps = [&](size_t start, size_t last_node) {
 
@@ -6435,3 +6452,21 @@
 }
 
 GGML_BACKEND_DL_IMPL(ggml_backend_cuda_reg)
+
+int ggml_backend_cuda_get_fusion_override(ggml_backend_t backend) {
+    if (!ggml_backend_is_cuda(backend)) return -2;
+    return ggml_cuda_fusion_override((ggml_backend_cuda_context *)backend->context);
+}
+
+bool ggml_backend_cuda_set_fusion_override(ggml_backend_t backend, int mode) {
+    if (!ggml_backend_is_cuda(backend) || mode < -1 || mode > 1) return false;
+    auto * ctx = (ggml_backend_cuda_context *)backend->context;
+    if (ggml_cuda_fusion_override(ctx) == mode) return true;
+    // Captured graphs encode the old selection and must never be replayed under
+    // a different policy. Externally serialized like all mutable backend calls.
+    ggml_backend_cuda_graph_cache_clear(backend);
+    std::lock_guard<std::mutex> lock(ggml_cuda_fusion_override_mutex);
+    if (mode == -1) ggml_cuda_fusion_overrides.erase(ctx);
+    else ggml_cuda_fusion_overrides[ctx] = mode;
+    return true;
+}
