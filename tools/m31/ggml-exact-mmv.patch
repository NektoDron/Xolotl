+// M31 per-node projection dispatch. Mark before allocation/capture; immutable
+// afterwards. Only contiguous 2D F32/Q4_K/Q5_K/Q6_K/Q8_0 weights, F32 input and K1..4 are
+// supported. Source weights must be leaf NONE tensors in a bound immutable
+// WEIGHTS buffer; computed/CAST operands and unbound leaves are rejected before
+// allocation. Rejects unsupported nodes without mutation. Preserves precision and
+// hint slots; uses reserved MUL_MAT op_params[15] and sets an output fence so a
+// fusion cannot bypass the requested dispatch. Unmarked nodes are unchanged.
+#define GGML_CUDA_HAS_EXACT_MMV_MARKER 1
