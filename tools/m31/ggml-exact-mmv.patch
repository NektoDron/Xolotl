+// MUL_MAT uses slots0(precision) and1(hint) in the pinned ggml revision.
+// Slot15 is otherwise unused for this op. The explicit magic avoids treating a
+// generic nonzero parameter as a dispatch instruction.
+static constexpr int32_t ggml_cuda_exact_mmv_magic = 0x4d33314d;
+static bool ggml_cuda_exact_mmv_marked(const ggml_tensor * node) {
+    return node && node->op == GGML_OP_MUL_MAT &&
+        ggml_get_op_params_i32(node,15) == ggml_cuda_exact_mmv_magic;
+}
+static bool ggml_cuda_exact_mmv_eligible(const ggml_tensor * node) {
+    if (!node || node->op != GGML_OP_MUL_MAT || node->type != GGML_TYPE_F32 ||
+            !node->src[0] || !node->src[1]) return false;
+    const auto * weight = node->src[0];
+    const auto * input = node->src[1];
+    auto * weight_buffer = weight->view_src ? weight->view_src->buffer : weight->buffer;
+    if (weight->op != GGML_OP_NONE || !weight_buffer ||
+            ggml_backend_buffer_get_usage(weight_buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) return false;
+    if (weight->type != GGML_TYPE_F32 && weight->type != GGML_TYPE_Q4_K && weight->type != GGML_TYPE_Q5_K && weight->type != GGML_TYPE_Q6_K && weight->type != GGML_TYPE_Q8_0) return false;
+    return input->type == GGML_TYPE_F32 && ggml_get_op_params_i32(node,1) == GGML_HINT_NONE &&
+        weight->ne[0] > 0 && weight->ne[1] > 0 && input->ne[0] == weight->ne[0] &&
+        input->ne[1] >= 1 && input->ne[1] <= 4 &&
+        weight->ne[2] == 1 && weight->ne[3] == 1 && input->ne[2] == 1 && input->ne[3] == 1 &&
+        node->ne[0] == weight->ne[1] && node->ne[1] == input->ne[1] && node->ne[2] == 1 && node->ne[3] == 1 &&
+        ggml_is_contiguous(weight) && ggml_is_contiguous(input) && ggml_is_contiguous(node);
+}
