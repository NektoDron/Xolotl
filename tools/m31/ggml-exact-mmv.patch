+
+bool ggml_cuda_mul_mat_set_exact_mmv(ggml_tensor * node) {
+    if (!ggml_cuda_exact_mmv_eligible(node)) return false;
+    const int32_t previous = ggml_get_op_params_i32(node,15);
+    if (previous != 0 && previous != ggml_cuda_exact_mmv_magic) return false;
+    ggml_set_op_params_i32(node,15,ggml_cuda_exact_mmv_magic);
+    ggml_set_output(node);
+    return true;
+}
