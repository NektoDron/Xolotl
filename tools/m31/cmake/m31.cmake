# The M31 port is isolated: enabling it does not change any existing engine's arithmetic.
option(STRATA_M31 "Build experimental MiniMax-M3.1 correctness tools" OFF)
if(NOT STRATA_M31)
  return()
endif()
set(_m31_dir ${CMAKE_CURRENT_SOURCE_DIR}/tools/m31)
add_executable(m31_inspect ${_m31_dir}/m31_inspect.cpp)
target_include_directories(m31_inspect PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include ${_m31_dir})
if(TARGET ggml-cpu)
  find_package(Threads REQUIRED)
  add_library(m31_engine STATIC ${_m31_dir}/m31_engine.cpp ${_m31_dir}/m31_gpu_experts.cpp
    ${_m31_dir}/cpu_gpu_host_executor.cpp ${_m31_dir}/shortprefill_cuda_math_cpu.cpp)
  target_include_directories(m31_engine PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include ${_m31_dir})
  target_include_directories(m31_engine PRIVATE ${strata_llamacpp_SOURCE_DIR}/ggml/src)
  target_link_libraries(m31_engine PUBLIC ggml ggml-cpu ggml-base Threads::Threads)
  set_source_files_properties(${_m31_dir}/cpu_gpu_host_executor.cpp
    PROPERTIES COMPILE_OPTIONS "-frounding-math;-fno-fast-math")
  add_executable(m31_generate ${_m31_dir}/m31_generate.cpp)
  target_include_directories(m31_generate PRIVATE ${strata_llamacpp_SOURCE_DIR}/vendor/nlohmann)
  target_link_libraries(m31_generate PRIVATE m31_engine)
  add_executable(m31_ttft_gate ${_m31_dir}/ttft_gate.cpp)
  target_include_directories(m31_ttft_gate PRIVATE ${strata_llamacpp_SOURCE_DIR}/vendor/nlohmann)
  target_link_libraries(m31_ttft_gate PRIVATE m31_engine)
  add_executable(m31_shortprefill_bench ${_m31_dir}/shortprefill_bench.cpp)
  target_include_directories(m31_shortprefill_bench PRIVATE ${strata_llamacpp_SOURCE_DIR}/vendor/nlohmann)
  target_link_libraries(m31_shortprefill_bench PRIVATE m31_engine)
  add_executable(m31_shortprefill_policy_test ${_m31_dir}/shortprefill_policy_test.cpp)
  add_executable(m31_shortprefill_cost_test ${_m31_dir}/shortprefill_cost_test.cpp)
  add_executable(m31_shortprefill_cpu_lane_test ${_m31_dir}/shortprefill_cpu_lane_test.cpp)
  target_link_libraries(m31_shortprefill_cpu_lane_test PRIVATE Threads::Threads)
  add_executable(m31_shortprefill_cuda_nvfp4_cpu_test ${_m31_dir}/shortprefill_cuda_nvfp4_cpu_test.cpp)
  foreach(_m31_assert_test m31_shortprefill_policy_test m31_shortprefill_cost_test m31_shortprefill_cpu_lane_test m31_shortprefill_cuda_nvfp4_cpu_test)
    if(MSVC)
      target_compile_options(${_m31_assert_test} PRIVATE /UNDEBUG)
    else()
      target_compile_options(${_m31_assert_test} PRIVATE -UNDEBUG)
    endif()
  endforeach()
  add_executable(m31_shortprefill_cpu_executor_test ${_m31_dir}/shortprefill_cpu_executor_test.cpp)
  target_link_libraries(m31_shortprefill_cpu_executor_test PRIVATE m31_engine)
  add_executable(m31_shortprefill_cuda_math_cpu_test ${_m31_dir}/shortprefill_cuda_math_cpu_test.cpp)
  target_include_directories(m31_shortprefill_cuda_math_cpu_test PRIVATE ${strata_llamacpp_SOURCE_DIR}/ggml/src)
  target_link_libraries(m31_shortprefill_cuda_math_cpu_test PRIVATE m31_engine)
  add_executable(m31_shortprefill_cuda_executor_test ${_m31_dir}/shortprefill_cuda_executor_test.cpp)
  target_link_libraries(m31_shortprefill_cuda_executor_test PRIVATE m31_engine)
  if(NOT MSVC)
    target_compile_options(m31_shortprefill_cuda_math_cpu_test PRIVATE -fno-fast-math -ffp-contract=off)
    target_compile_options(m31_shortprefill_cuda_nvfp4_cpu_test PRIVATE -fno-fast-math -ffp-contract=off)
    target_compile_options(m31_shortprefill_cuda_executor_test PRIVATE -fno-fast-math -ffp-contract=off)
  endif()
  if(STRATA_BUILD_TESTS)
    add_test(NAME m31_shortprefill_policy COMMAND m31_shortprefill_policy_test)
    add_test(NAME m31_shortprefill_cost COMMAND m31_shortprefill_cost_test)
    add_test(NAME m31_shortprefill_cpu_lane COMMAND m31_shortprefill_cpu_lane_test)
    add_test(NAME m31_shortprefill_cpu_executor COMMAND m31_shortprefill_cpu_executor_test)
    add_test(NAME m31_shortprefill_cuda_math_cpu COMMAND m31_shortprefill_cuda_math_cpu_test)
    add_test(NAME m31_shortprefill_cuda_nvfp4_cpu COMMAND m31_shortprefill_cuda_nvfp4_cpu_test)
    add_test(NAME m31_shortprefill_cuda_executor COMMAND m31_shortprefill_cuda_executor_test)
  endif()
  add_executable(m31_expert_check ${_m31_dir}/m31_expert_check.cpp)
  target_link_libraries(m31_expert_check PRIVATE m31_engine)
  add_executable(m31_shortprefill_gpu_quant_check ${_m31_dir}/shortprefill_gpu_quant_check.cpp)
  target_include_directories(m31_shortprefill_gpu_quant_check PRIVATE ${strata_llamacpp_SOURCE_DIR}/vendor/nlohmann)
  target_link_libraries(m31_shortprefill_gpu_quant_check PRIVATE m31_engine)
  if(NOT MSVC)
    set_source_files_properties(${_m31_dir}/shortprefill_cuda_math_cpu.cpp ${_m31_dir}/m31_expert_check.cpp
      PROPERTIES COMPILE_OPTIONS "-fno-fast-math;-ffp-contract=off")
  endif()
  add_executable(m31_serve ${_m31_dir}/m31_serve.cpp)
  target_include_directories(m31_serve PRIVATE ${strata_llamacpp_SOURCE_DIR}/vendor/nlohmann)
  target_link_libraries(m31_serve PRIVATE m31_engine)
  if(TARGET ggml-cuda)
    target_sources(m31_engine PRIVATE ${_m31_dir}/gpu_attention_fill.cu ${_m31_dir}/shortprefill_gpu_quant.cu)
    set_source_files_properties(${_m31_dir}/shortprefill_gpu_quant.cu PROPERTIES COMPILE_OPTIONS "--use_fast_math")
    set_target_properties(m31_engine PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON)
    target_link_libraries(m31_engine PRIVATE CUDA::cudart)
    target_link_libraries(m31_shortprefill_bench PRIVATE CUDA::cudart)
    target_link_libraries(m31_engine PUBLIC ggml-cuda)
    target_compile_definitions(m31_engine PRIVATE M31_ENGINE_CUDA=1)
    target_compile_definitions(m31_engine PRIVATE M31_SHORT_GPU_QUANT_CUDA=1)
    target_compile_definitions(m31_generate PRIVATE M31_HAVE_CUDA=1)
    target_compile_definitions(m31_ttft_gate PRIVATE M31_HAVE_CUDA=1)
    target_compile_definitions(m31_shortprefill_bench PRIVATE M31_HAVE_CUDA=1)
    target_compile_definitions(m31_expert_check PRIVATE M31_HAVE_CUDA=1)
    target_compile_definitions(m31_serve PRIVATE M31_HAVE_CUDA=1)
  else()
    target_sources(m31_engine PRIVATE ${_m31_dir}/shortprefill_gpu_quant_stub.cpp)
  endif()
  if(STRATA_BUILD_TESTS)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(Python3_Interpreter_FOUND)
      add_test(NAME m31_math COMMAND ${Python3_EXECUTABLE} ${_m31_dir}/tests/test_math.py
        --engine $<TARGET_FILE:m31_generate> --inspect $<TARGET_FILE:m31_inspect>)
      set_tests_properties(m31_math PROPERTIES SKIP_RETURN_CODE 77
        ENVIRONMENT "OPENBLAS_NUM_THREADS=1;OMP_NUM_THREADS=2;CUDA_VISIBLE_DEVICES=")
      add_test(NAME m31_compare COMMAND ${Python3_EXECUTABLE} ${_m31_dir}/tests/test_compare.py)
    endif()
  endif()
endif()

# The ordinary CUDA implementation is ggml/MMQ. Additional custom arithmetic
# and CPU-exact verification kernels are independent optional implementations.
set(_m31_fast_ffn_default OFF)
if(TARGET ggml-cuda AND TARGET m31_engine)
  set(_m31_fast_ffn_default ON)
endif()
option(STRATA_M31_FAST_FFN_CUDA "M31 experimental custom resident expert FFN" OFF)
option(STRATA_M31_CPU_QUANTS_CUDA "M31 CPU-compatible CUDA dots for optional exact verification" OFF)
option(STRATA_M31_REGISTERED_ARENA_CUDA "M31 direct DMA from registered expert arena" ${_m31_fast_ffn_default})
if(STRATA_M31_FAST_FFN_CUDA OR STRATA_M31_CPU_QUANTS_CUDA OR STRATA_M31_REGISTERED_ARENA_CUDA)
  if(NOT TARGET ggml-cuda OR NOT TARGET m31_engine)
    message(FATAL_ERROR "M31 CUDA FFN implementations require M31 CUDA")
  endif()
  set_target_properties(m31_engine PROPERTIES CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON)
  target_include_directories(m31_engine PRIVATE ${strata_llamacpp_SOURCE_DIR}/ggml/src)
endif()
if(STRATA_M31_FAST_FFN_CUDA)
  target_sources(m31_engine PRIVATE ${_m31_dir}/gpu_fast_ffn.cu)
  target_link_libraries(m31_engine PRIVATE CUDA::cudart CUDA::cublas)
  target_compile_definitions(m31_engine PRIVATE M31_FAST_FFN_CUDA=1)
endif()
if(STRATA_M31_REGISTERED_ARENA_CUDA)
  target_sources(m31_engine PRIVATE ${_m31_dir}/gpu_registered_arena.cu)
  target_link_libraries(m31_engine PRIVATE CUDA::cudart)
  target_compile_definitions(m31_engine PRIVATE M31_REGISTERED_ARENA_CUDA=1)
endif()
if(STRATA_M31_CPU_QUANTS_CUDA)
  find_package(Threads REQUIRED)
  target_sources(m31_engine PRIVATE ${_m31_dir}/gpu_cpu_quants.cu ${_m31_dir}/cpu_gpu_host_ops.cpp)
  target_link_libraries(m31_engine PRIVATE Threads::Threads)
  set_source_files_properties(${_m31_dir}/cpu_gpu_host_executor.cpp ${_m31_dir}/cpu_gpu_host_ops.cpp
    PROPERTIES COMPILE_OPTIONS "-frounding-math;-fno-fast-math")
  target_compile_definitions(m31_engine PRIVATE M31_CPU_QUANTS_CUDA=1)
  target_compile_definitions(m31_expert_check PRIVATE M31_CPU_QUANTS_CUDA=1)
endif()
